OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=youraddress@example.com
SMTP_PASS=app_password_or_svc_key
FROM_EMAIL=youraddress@example.com
TO_EMAILS=parent1@example.com,parent2@example.com
NEWSLETTER_SEND_HOUR_ET=9
DB_PATH=./data/richmond.db

# Selection / ranking
# Kids are configured in src/rk/config.py (_DEFAULT_KIDS), birthdate-based so
# age is always current. To override without editing code, set KIDS_JSON here, e.g.:
# KIDS_JSON=[{"name":"Kid 1","birthdate":"2025-04-02","interests":[]},{"name":"Kid 2","birthdate":"2023-07-02","interests":["dinosaurs"]}]
